# Copy to .env and adjust for your environment.
QT_ENV=dev
QT_LOG_LEVEL=INFO

# Data
QT_DATA_DIR=./data_cache
QT_ARTIFACTS_DIR=./artifacts
QT_DB_URL=sqlite:///./data_cache/quanttrade.sqlite3

# Default exchange / market
QT_EXCHANGE=binance
QT_DEFAULT_SYMBOL=BTC/USDT
QT_DEFAULT_TIMEFRAME=1h

# Backtesting
QT_INITIAL_CAPITAL=10000
QT_COMMISSION_BPS=5
QT_SLIPPAGE_BPS=2

# Risk
QT_RISK_PER_TRADE=0.01
QT_MAX_PORTFOLIO_RISK=0.05

# API
QT_API_HOST=0.0.0.0
QT_API_PORT=8000
